# Read by both the browser (NEXT_PUBLIC_* is inlined at build time — the
# API URL isn't a secret) and the Route Handlers under app/api/auth/*
# (server-side, same var — see ADR-020 and src/lib/server-config.ts).
# Production: https://api.shrianandamsweets.in/api/v1 — this app itself
# deploys to https://admin.shrianandamsweets.in (see
# docs/deployment/domain-and-dns.md).
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
