# ==============================================================================
# Shri Anandam Platform — Environment Configuration Template
# Copy to .env and fill in real values. NEVER commit the real .env file.
# ==============================================================================

# --- App ---
NODE_ENV=development
APP_NAME=shri-anandam-api
APP_PORT=4000
APP_URL=http://localhost:4000
API_PREFIX=api/v1
LOG_LEVEL=debug

# --- Database (PostgreSQL) ---
# Port 55433 (not 5432) — see docker-compose.yml comment: 5432 is commonly
# already taken by other local projects on a dev machine.
DATABASE_URL=postgresql://shri_anandam:changeme@localhost:55433/shri_anandam_dev?schema=public
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# --- Redis (cache, queues, rate limiting) ---
# Port 6381 (not 6379) — same reason as above.
REDIS_URL=redis://localhost:6381

# --- Auth / JWT ---
JWT_ACCESS_SECRET=replace-with-32-byte-random-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=replace-with-different-32-byte-random-secret
JWT_REFRESH_TTL=30d
PASSWORD_HASH_SALT_ROUNDS=12

# --- OTP (customer auth) ---
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=5

# --- SMS provider (OTP delivery) ---
SMS_PROVIDER=msg91
SMS_API_KEY=
SMS_SENDER_ID=SHRIAN

# --- Firebase Cloud Messaging (push notifications — read by both
# services/api's config and services/notification-worker) ---
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# --- notification-worker only ---
# How often it polls outbox_events for PENDING rows, and how many it
# claims per tick. Defaults (below) are fine for local dev.
POLL_INTERVAL_MS=3000
OUTBOX_BATCH_SIZE=20

# --- Payment Gateway (e.g. Razorpay) ---
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- S3-compatible object storage ---
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=shri-anandam-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Rate limiting ---
# This is the GLOBAL per-IP ceiling every route gets unless overridden
# with a stricter @Throttle() (auth/OTP routes are — see
# docs/architecture/security-architecture.md). Phase 12 load testing
# found the old default (100) too tight for real legitimate traffic
# sharing one IP (a restaurant's own NAT'd connection): kitchen-web's
# queue alone issues 5 parallel per-status requests every 5s = 60
# req/min from a SINGLE open screen, before counting admin-web's own
# polling, any staff phones on the same wifi, or customer traffic
# through the same NAT. Raised to leave real headroom above that math
# rather than one busy kitchen display legitimately tripping the
# platform's own abuse protection.
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=300

# --- Observability ---
# Read by services/api/src/sentry.ts — leave blank locally; Sentry.init()
# and every capture call are safe no-ops without a real DSN.
SENTRY_DSN=
# Not yet consumed anywhere (see production-architecture.md's
# Observability section — OpenTelemetry was deliberately left unwired
# in Phase 12: no OTLP collector exists in this repo's environment to
# verify a real exporter against). Kept here as the target for whoever
# wires it up against a real collector.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- Message queue (Redis Streams by default) ---
QUEUE_DRIVER=redis-streams
