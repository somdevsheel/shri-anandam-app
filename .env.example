# ==============================================================================
# Shri Anandam Platform — Environment Configuration Template
# Copy to .env and fill in real values. NEVER commit the real .env file.
# ==============================================================================

# --- App ---
NODE_ENV=development
APP_NAME=shri-anandam-api
APP_PORT=4000
# Production: https://api.shrianandamsweets.in (Nginx terminates TLS and
# reverse-proxies to this port on the Lightsail instance — see
# docs/deployment/domain-and-dns.md; the app itself always listens plain
# HTTP on APP_PORT regardless of environment).
APP_URL=http://localhost:4000
API_PREFIX=api/v1
LOG_LEVEL=debug

# --- Database (PostgreSQL) ---
# Port 55433 (not 5432) — see docker-compose.yml comment: 5432 is commonly
# already taken by other local projects on a dev machine.
DATABASE_URL=postgresql://shri_anandam:changeme@localhost:55433/shri_anandam_dev?schema=public
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# --- Production database/Redis credentials (infrastructure/docker/
# docker-compose.prod.yml only — see docs/deployment/aws-lightsail-setup.md).
# Not read by the app directly; they exist so the same .env can hand
# matching credentials to both the Postgres/Redis containers AND the
# DATABASE_URL/REDIS_URL above (which must be updated to embed these same
# values — standard port 5432/6379, not the dev remap above — once you
# generate real ones: `openssl rand -base64 24`).
POSTGRES_USER=shri_anandam
POSTGRES_PASSWORD=
POSTGRES_DB=shri_anandam_prod
REDIS_PASSWORD=

# --- Redis (cache, queues, rate limiting) ---
# Port 6381 (not 6379) — same reason as above.
REDIS_URL=redis://localhost:6381

# --- Auth / JWT ---
JWT_ACCESS_SECRET=replace-with-32-byte-random-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=replace-with-different-32-byte-random-secret
JWT_REFRESH_TTL=30d
PASSWORD_HASH_SALT_ROUNDS=12

# --- OTP (customer auth) ---
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=5
# TEMPORARY escape hatch: with this set, OtpService.verifyOtp() accepts
# this fixed code for ANY phone number — no real OTP is checked at all.
# Exists because there is currently no real SMS provider wired up
# anywhere in this codebase (see SMS_PROVIDER's own comment below) —
# services/api/src/auth/auth.module.ts unconditionally binds
# ConsoleSmsProvider, which throws by design if NODE_ENV=production,
# so customer OTP login is otherwise completely broken wherever this
# isn't set. Loudly logged (Logger.warn) every time it's used, so it's
# auditable, not silent. UNSET THIS the moment a real SMS provider is
# wired up — while set, anyone can log in as any customer phone number
# without proving they own it.
OTP_BYPASS_CODE=

# --- SMS provider (OTP delivery) ---
# SMS_PROVIDER is validated/typed but NOT actually read by any code —
# AuthModule always binds ConsoleSmsProvider (logs the OTP instead of
# sending it) regardless of this value; no MSG91Provider (or any other
# real provider) exists in the codebase yet. Changing this value alone
# does nothing. A real integration needs: (1) an MSG91Provider class
# implementing SmsProvider, (2) AuthModule's SMS_PROVIDER binding made
# conditional on this value instead of hardcoded, (3) real credentials
# below.
SMS_PROVIDER=msg91
SMS_API_KEY=
SMS_SENDER_ID=SHRIAN

# --- Firebase Cloud Messaging (push notifications — read by both
# services/api's config and services/notification-worker) ---
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# --- notification-worker only ---
# How often it polls outbox_events for PENDING rows, and how many it
# claims per tick. Defaults (below) are fine for local dev.
POLL_INTERVAL_MS=3000
OUTBOX_BATCH_SIZE=20

# --- Payment Gateway (e.g. Razorpay) ---
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- S3 object storage (product images — services/api/src/uploads) ---
# Real AWS S3, not just S3-compatible-in-theory: leave S3_ENDPOINT blank
# for actual AWS (the SDK derives the endpoint from S3_REGION); set it
# only for a genuinely S3-compatible alternative (MinIO, DO Spaces, ...).
# The bucket needs a policy granting public s3:GetObject on
# `products/*` (only that prefix — the rest of the bucket stays
# private) — product images must be viewable by customers without
# auth. Without S3_BUCKET/S3_ACCESS_KEY_ID/S3_SECRET_ACCESS_KEY set,
# POST /uploads/product-image fails closed with a clear 503, same
# pattern as the FCM/SMS providers when unconfigured — nothing else
# breaks.
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=shri-anandam-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- CORS ---
# Only browser-based apps need an entry here (admin-web, kitchen-web) —
# the mobile apps and Socket.IO's own client aren't subject to CORS.
# Production: https://admin.shrianandamsweets.in,https://kitchen.shrianandamsweets.in
# (see docs/deployment/domain-and-dns.md).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Rate limiting ---
# This is the GLOBAL per-IP ceiling every route gets unless overridden
# with a stricter @Throttle() (auth/OTP routes are — see
# docs/architecture/security-architecture.md). Phase 12 load testing
# found the old default (100) too tight for real legitimate traffic
# sharing one IP (a restaurant's own NAT'd connection): kitchen-web's
# queue alone issues 5 parallel per-status requests every 5s = 60
# req/min from a SINGLE open screen, before counting admin-web's own
# polling, any staff phones on the same wifi, or customer traffic
# through the same NAT. Raised to leave real headroom above that math
# rather than one busy kitchen display legitimately tripping the
# platform's own abuse protection.
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=300

# --- Observability ---
# Read by services/api/src/sentry.ts — leave blank locally; Sentry.init()
# and every capture call are safe no-ops without a real DSN.
SENTRY_DSN=
# Not yet consumed anywhere (see production-architecture.md's
# Observability section — OpenTelemetry was deliberately left unwired
# in Phase 12: no OTLP collector exists in this repo's environment to
# verify a real exporter against). Kept here as the target for whoever
# wires it up against a real collector.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- Message queue (Redis Streams by default) ---
QUEUE_DRIVER=redis-streams
