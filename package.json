{
  "name": "shri-anandam-platform",
  "private": true,
  "version": "0.1.0",
  "description": "Shri Anandam Sweets & Restaurant — production ordering platform monorepo",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "pnpm -r --filter=./packages/* --filter=./services/* build",
    "dev:api": "pnpm --filter @shri-anandam/api start:dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\" --ignore-path .gitignore",
    "docker:up": "docker compose -f docker-compose.yml up -d",
    "docker:down": "docker compose -f docker-compose.yml down",
    "prisma:generate": "pnpm --filter @shri-anandam/api prisma:generate",
    "prisma:migrate": "pnpm --filter @shri-anandam/api prisma:migrate",
    "prisma:studio": "pnpm --filter @shri-anandam/api prisma:studio"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4"
  }
}
