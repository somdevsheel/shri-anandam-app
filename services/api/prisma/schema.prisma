// Shri Anandam Sweets & Restaurant — core relational schema.
//
// Design rules followed throughout (see docs/architecture/database-architecture.md):
//  - UUID primary keys everywhere (uuid v4, generated by the database).
//  - createdAt/updatedAt on every mutable table.
//  - Foreign keys + unique constraints instead of app-level-only integrity.
//  - Money is stored as integer paise (Int/BigInt), never floating point.
//  - Weight-based inventory is stored in grams as Decimal(12,3) for
//    sub-gram precision without float rounding error.
//  - JSON columns are used ONLY for provider/webhook metadata and audit
//    diffs — never for core relational fields that need to be queried,
//    joined, or constrained.
//  - Enum string values are the single source of truth mirrored (by hand)
//    in packages/shared-types/src/enums/*.ts — see the comment at the top
//    of each of those files.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// ENUMS
// =============================================================================

enum OrderStatus {
  PENDING
  ACCEPTED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  REJECTED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  CANCELLED
  REFUND_PENDING
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  UPI
  CARD
  NET_BANKING
  COD
  PAY_AT_STORE
  DIRECT_UPI
}

enum PaymentProvider {
  RAZORPAY
  MANUAL
}

enum PaymentTransactionType {
  AUTHORIZATION
  CAPTURE
  MANUAL_COLLECTION
  REFUND
}

enum RefundStatus {
  PENDING
  SUCCESS
  FAILED
}

enum FulfillmentType {
  DELIVERY
  PICKUP
}

enum ActorType {
  CUSTOMER
  STAFF
  SYSTEM
}

enum StaffRoleName {
  OWNER
  MANAGER
  CASHIER
  KITCHEN
  SUPPORT
  ACCOUNTANT
}

enum Platform {
  ANDROID
  IOS
  WEB
}

enum AppType {
  CUSTOMER
  OWNER
  ADMIN
  KITCHEN
}

enum InventoryUnit {
  GRAM
  PIECE
}

enum InventoryTransactionType {
  RESTOCK
  SALE
  ADJUSTMENT
  WASTAGE
  RESERVATION
  RELEASE
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
  EXPIRED
}

enum DeliveryAssignmentStatus {
  UNASSIGNED
  ASSIGNED
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
}

enum CouponType {
  PERCENTAGE
  FIXED
}

enum CouponRuleType {
  PRODUCT
  CATEGORY
  BRANCH
}

enum NotificationChannel {
  PUSH
  EMAIL
  SMS
  WHATSAPP
}

enum NotificationCategory {
  TRANSACTIONAL
  MARKETING
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  READ
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
}

// =============================================================================
// IDENTITY
// =============================================================================

model Customer {
  id           String   @id @default(uuid())
  mobileNumber String   @unique
  email        String?
  name         String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  addresses      CustomerAddress[]
  orders         Order[]
  deviceTokens   DeviceToken[]
  sessions       Session[]
  reviews        Review[]
  couponUsages   CouponUsage[]
  notifications  Notification[]

  @@index([mobileNumber])
  @@map("customers")
}

model CustomerAddress {
  id          String   @id @default(uuid())
  customerId  String
  label       String? // "Home", "Work", ...
  contactName String
  contactPhone String
  line1       String
  line2       String?
  city        String
  state       String
  pincode     String
  latitude    Float?
  longitude   Float?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([pincode])
  @@map("customer_addresses")
}

model Staff {
  id                 String    @id @default(uuid())
  email              String    @unique
  passwordHash       String
  name               String
  phone              String?
  isActive           Boolean   @default(true)
  mfaEnabled         Boolean   @default(false)
  mfaSecret          String?
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  staffRoles      StaffRole[]
  branchStaff     BranchStaff[]
  sessions        Session[]
  deviceTokens    DeviceToken[]
  auditLogsActor  AuditLog[]        @relation("AuditLogActor")
  orderNotes      OrderNote[]
  priceChanges    PriceHistory[]
  reviewReplies   ReviewReply[]

  @@map("staff")
}

model Role {
  id          String   @id @default(uuid())
  name        StaffRoleName @unique
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]
  staffRoles      StaffRole[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  key         String   @unique // e.g. "order.read"
  description String?

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model StaffRole {
  staffId String
  roleId  String

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)
  role  Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([staffId, roleId])
  @@map("staff_roles")
}

model Session {
  id               String    @id @default(uuid())
  customerId       String?
  staffId          String?
  refreshTokenHash String    @unique
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  staff    Staff?    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([staffId])
  @@index([expiresAt])
  @@map("sessions")
}

model DeviceToken {
  id           String   @id @default(uuid())
  customerId   String?
  staffId      String?
  fcmToken     String   @unique
  platform     Platform
  appType      AppType
  isActive     Boolean  @default(true)
  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  staff    Staff?    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([staffId])
  @@index([appType, isActive])
  @@map("device_tokens")
}

// =============================================================================
// ORGANIZATION
// =============================================================================

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  branches Branch[]

  @@map("organizations")
}

model Branch {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  code           String   @unique
  address        String
  phone          String?
  isActive       Boolean  @default(true)
  latitude       Float?
  longitude      Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization      Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchStaff        BranchStaff[]
  branchProducts      BranchProduct[]
  orders             Order[]
  inventoryItems     InventoryItem[]
  deliveryZones      DeliveryZone[]
  productionBatches  ProductionBatch[]

  @@index([organizationId])
  @@map("branches")
}

model BranchStaff {
  id        String   @id @default(uuid())
  branchId  String
  staffId   String
  createdAt DateTime @default(now())

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  staff  Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([branchId, staffId])
  @@map("branch_staff")
}

model BranchProduct {
  id         String   @id @default(uuid())
  branchId   String
  productId  String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([branchId, productId])
  @@index([branchId, isActive])
  @@map("branch_products")
}

// =============================================================================
// CATALOG
// =============================================================================

model Category {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  parentId  String?
  imageUrl  String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  children Category[] @relation("CategoryToCategory")
  products Product[]

  @@index([parentId])
  @@map("categories")
}

model Product {
  id          String   @id @default(uuid())
  categoryId  String
  name        String
  slug        String   @unique
  description String?
  tags        String[] @default([])
  isActive    Boolean  @default(true)
  isFeatured  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category       Category        @relation(fields: [categoryId], references: [id])
  variants       ProductVariant[]
  images         ProductImage[]
  productAddons  ProductAddon[]
  branchProducts BranchProduct[]
  orderItems     OrderItem[]
  reviews        Review[]

  @@index([categoryId, isActive])
  @@map("products")
}

model ProductVariant {
  id                  String   @id @default(uuid())
  productId           String
  name                String   // e.g. "500g", "1kg", "Regular"
  sku                 String   @unique
  weightGrams         Decimal? @db.Decimal(10, 3)
  priceInPaise        Int
  compareAtPriceInPaise Int?
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  product          Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems       OrderItem[]
  priceHistory     PriceHistory[]
  inventoryItems   InventoryItem[]
  productionBatches ProductionBatch[]

  @@index([productId, isActive])
  @@map("product_variants")
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  url       String
  altText   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model Addon {
  id            String   @id @default(uuid())
  name          String
  priceInPaise  Int
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  productAddons ProductAddon[]

  @@map("addons")
}

model ProductAddon {
  productId String
  addonId   String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  addon   Addon   @relation(fields: [addonId], references: [id], onDelete: Cascade)

  @@id([productId, addonId])
  @@map("product_addons")
}

model PriceHistory {
  id                String   @id @default(uuid())
  variantId         String
  oldPriceInPaise   Int
  newPriceInPaise   Int
  changedByStaffId  String?
  reason            String?
  createdAt         DateTime @default(now())

  variant         ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  changedByStaff  Staff?         @relation(fields: [changedByStaffId], references: [id])

  @@index([variantId])
  @@map("price_history")
}

// =============================================================================
// ORDERS
// =============================================================================

model Order {
  id              String          @id @default(uuid())
  orderNumber     String          @unique // e.g. SA-20260904-1025
  branchId        String
  customerId      String
  status          OrderStatus     @default(PENDING)
  paymentStatus   PaymentStatus   @default(PENDING)
  fulfillmentType FulfillmentType
  scheduledFor    DateTime?

  subtotalInPaise    Int
  discountInPaise    Int      @default(0)
  deliveryFeeInPaise Int      @default(0)
  taxInPaise         Int      @default(0)
  totalInPaise       Int

  couponId       String?
  idempotencyKey String?  @unique

  placedAt  DateTime  @default(now())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  branch             Branch               @relation(fields: [branchId], references: [id])
  customer           Customer             @relation(fields: [customerId], references: [id])
  coupon             Coupon?              @relation(fields: [couponId], references: [id])
  items              OrderItem[]
  addressSnapshot    OrderAddressSnapshot?
  statusHistory      OrderStatusHistory[]
  notes              OrderNote[]
  events             OrderEvent[]
  payments           Payment[]
  deliveryAssignment DeliveryAssignment?
  couponUsage        CouponUsage?
  reviews            Review[]
  stockReservations  StockReservation[]
  inventoryTxns      InventoryTransaction[]

  @@index([customerId])
  @@index([branchId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@map("orders")
}

/// Immutable snapshot of the delivery/pickup address at order time —
/// later edits to CustomerAddress must never change historical orders.
model OrderAddressSnapshot {
  id           String  @id @default(uuid())
  orderId      String  @unique
  contactName  String
  contactPhone String
  line1        String
  line2        String?
  city         String
  state        String
  pincode      String
  latitude     Float?
  longitude    Float?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_address_snapshots")
}

model OrderItem {
  id        String @id @default(uuid())
  orderId   String
  productId String
  variantId String

  // Snapshot fields — preserved exactly as displayed to the customer at
  // order time, independent of later catalog/price changes.
  productNameSnapshot String
  variantNameSnapshot String
  quantity            Int
  unitPriceInPaise    Int
  discountInPaise     Int    @default(0)
  taxInPaise          Int    @default(0)
  finalPriceInPaise   Int
  specialInstructions String?

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id])
  variant ProductVariant @relation(fields: [variantId], references: [id])
  addons  OrderItemAddon[]

  @@index([orderId])
  @@map("order_items")
}

model OrderItemAddon {
  id                 String @id @default(uuid())
  orderItemId        String
  addonNameSnapshot  String
  priceInPaiseSnapshot Int

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
  @@map("order_item_addons")
}

model OrderStatusHistory {
  id              String      @id @default(uuid())
  orderId         String
  previousStatus  OrderStatus?
  newStatus       OrderStatus
  actorId         String?
  actorType       ActorType
  reason          String?
  createdAt       DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_status_history")
}

model OrderNote {
  id            String   @id @default(uuid())
  orderId       String
  authorStaffId String
  note          String
  createdAt     DateTime @default(now())

  order       Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  authorStaff Staff @relation(fields: [authorStaffId], references: [id])

  @@index([orderId])
  @@map("order_notes")
}

/// Customer-facing domain event trail for an order (drives the tracking
/// timeline UI). Distinct from OutboxEvent, which is the internal
/// transactional-outbox mechanism used to publish events to workers.
model OrderEvent {
  id        String   @id @default(uuid())
  orderId   String
  eventType String
  payload   Json?
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_events")
}

// =============================================================================
// PAYMENTS
// =============================================================================

model Payment {
  id                String          @id @default(uuid())
  orderId           String
  provider          PaymentProvider
  method            PaymentMethod
  status            PaymentStatus   @default(PENDING)
  amountInPaise     Int
  providerOrderId   String?
  providerPaymentId String?         @unique
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  order        Order                 @relation(fields: [orderId], references: [id])
  transactions PaymentTransaction[]
  refunds      Refund[]

  @@index([orderId])
  @@index([status])
  @@index([providerPaymentId])
  @@map("payments")
}

/// A single payment may have multiple transactions — e.g. a split order
/// paid ₹500 online + ₹1,000 cash both roll up under one logical order,
/// each as its own Payment + PaymentTransaction pair.
model PaymentTransaction {
  id                 String                  @id @default(uuid())
  paymentId          String
  type               PaymentTransactionType
  amountInPaise      Int
  collectedByStaffId String?
  referenceNumber    String?
  notes              String?
  occurredAt         DateTime                @default(now())
  createdAt          DateTime                @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@map("payment_transactions")
}

/// Raw inbound webhook log — signature-verified, deduplicated by
/// (provider, eventId), retained for troubleshooting and audit.
model PaymentWebhookEvent {
  id               String    @id @default(uuid())
  provider         PaymentProvider
  eventId          String
  signatureVerified Boolean
  rawPayload       Json
  processedAt      DateTime?
  createdAt        DateTime  @default(now())

  @@unique([provider, eventId])
  @@map("payment_webhooks")
}

model Refund {
  id                      String       @id @default(uuid())
  paymentId               String
  amountInPaise           Int
  reason                  String
  status                  RefundStatus @default(PENDING)
  initiatedByStaffId      String?
  providerRefundReference String?
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
  @@index([status])
  @@map("refunds")
}

// =============================================================================
// INVENTORY
// =============================================================================

model InventoryItem {
  id               String        @id @default(uuid())
  branchId         String
  productVariantId String
  unit             InventoryUnit
  stockQuantity    Decimal       @db.Decimal(12, 3) // grams, or whole pieces
  lowStockThreshold Decimal      @db.Decimal(12, 3) @default(0)
  updatedAt        DateTime      @updatedAt
  createdAt        DateTime      @default(now())

  branch            Branch             @relation(fields: [branchId], references: [id])
  productVariant    ProductVariant     @relation(fields: [productVariantId], references: [id])
  transactions      InventoryTransaction[]
  stockReservations StockReservation[]
  stockAdjustments  StockAdjustment[]
  wastageEntries    Wastage[]

  @@unique([branchId, productVariantId])
  @@index([branchId])
  @@map("inventory_items")
}

model InventoryTransaction {
  id              String                    @id @default(uuid())
  inventoryItemId String
  type            InventoryTransactionType
  quantityDelta   Decimal                   @db.Decimal(12, 3) // signed
  referenceOrderId String?
  staffId         String?
  note            String?
  createdAt       DateTime                  @default(now())

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])
  referenceOrder Order?       @relation(fields: [referenceOrderId], references: [id])

  @@index([inventoryItemId])
  @@index([referenceOrderId])
  @@map("inventory_transactions")
}

/// A hold placed on stock while an order is being placed/paid for.
/// Reservations expire (see stock-reservation TTL in
/// docs/architecture/database-architecture.md) and are released back to
/// available stock if the order is never completed.
model StockReservation {
  id              String             @id @default(uuid())
  inventoryItemId String
  orderId         String?
  quantity        Decimal            @db.Decimal(12, 3)
  status          ReservationStatus  @default(ACTIVE)
  expiresAt       DateTime
  createdAt       DateTime           @default(now())

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])
  order         Order?        @relation(fields: [orderId], references: [id])

  @@index([inventoryItemId, status])
  @@index([expiresAt])
  @@map("stock_reservations")
}

model StockAdjustment {
  id              String   @id @default(uuid())
  inventoryItemId String
  staffId         String
  quantityDelta   Decimal  @db.Decimal(12, 3)
  reason          String
  createdAt       DateTime @default(now())

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@index([inventoryItemId])
  @@map("stock_adjustments")
}

model ProductionBatch {
  id                String   @id @default(uuid())
  productVariantId  String
  branchId          String
  batchCode         String   @unique
  quantityProduced  Decimal  @db.Decimal(12, 3)
  producedAt        DateTime @default(now())
  expiresAt         DateTime?

  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])
  branch         Branch         @relation(fields: [branchId], references: [id])

  @@index([productVariantId])
  @@index([branchId])
  @@map("production_batches")
}

model Wastage {
  id              String   @id @default(uuid())
  inventoryItemId String
  quantity        Decimal  @db.Decimal(12, 3)
  reason          String
  staffId         String
  createdAt       DateTime @default(now())

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@index([inventoryItemId])
  @@map("wastage")
}

// =============================================================================
// DELIVERY
// =============================================================================

model DeliveryZone {
  id                          String   @id @default(uuid())
  branchId                    String
  name                        String
  pincodes                    String[] @default([])
  minOrderInPaise             Int      @default(0)
  deliveryFeeInPaise          Int      @default(0)
  freeDeliveryThresholdInPaise Int?
  isActive                    Boolean  @default(true)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  branch  Branch               @relation(fields: [branchId], references: [id])
  charges DeliveryChargeRule[]

  @@index([branchId])
  @@map("delivery_zones")
}

/// Optional tiered fee rules layered on top of a zone's base fee
/// (e.g. order < ₹300 => +₹20 surcharge).
model DeliveryChargeRule {
  id             String @id @default(uuid())
  deliveryZoneId String
  minOrderInPaise Int
  feeInPaise     Int

  deliveryZone DeliveryZone @relation(fields: [deliveryZoneId], references: [id], onDelete: Cascade)

  @@index([deliveryZoneId])
  @@map("delivery_charges")
}

/// Kept ready for a future delivery application (see section 28/73 of the
/// project brief) — V1 has no delivery-boy app; staff record assignment
/// manually through the admin panel.
model DeliveryAssignment {
  id                 String                   @id @default(uuid())
  orderId            String                   @unique
  deliveryPersonName String?
  deliveryPersonPhone String?
  vehicleNumber      String?
  status             DeliveryAssignmentStatus @default(UNASSIGNED)
  assignedByStaffId  String?
  assignedAt         DateTime?
  deliveredAt        DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("delivery_assignments")
}

// =============================================================================
// MARKETING
// =============================================================================

model Coupon {
  id                    String     @id @default(uuid())
  code                  String     @unique
  type                  CouponType
  value                 Int // percentage (0-100) or fixed paise, per `type`
  minOrderInPaise       Int?
  maxDiscountInPaise    Int?
  usageLimit            Int?
  perCustomerLimit      Int?
  isFirstOrderOnly      Boolean    @default(false)
  branchId              String? // null = all branches
  startsAt              DateTime
  endsAt                DateTime
  isActive              Boolean    @default(true)
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  rules  CouponRule[]
  usages CouponUsage[]
  orders Order[]

  @@index([code])
  @@index([isActive, startsAt, endsAt])
  @@map("coupons")
}

model CouponRule {
  id       String         @id @default(uuid())
  couponId String
  ruleType CouponRuleType
  refId    String // productId, categoryId, or branchId depending on ruleType

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@index([couponId])
  @@map("coupon_rules")
}

model CouponUsage {
  id                     String   @id @default(uuid())
  couponId               String
  customerId             String
  orderId                String   @unique
  discountAppliedInPaise Int
  usedAt                 DateTime @default(now())

  coupon   Coupon   @relation(fields: [couponId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])
  order    Order    @relation(fields: [orderId], references: [id])

  @@index([couponId, customerId])
  @@map("coupon_usage")
}

model Campaign {
  id          String   @id @default(uuid())
  name        String
  description String?
  startsAt    DateTime
  endsAt      DateTime
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@map("campaigns")
}

// =============================================================================
// COMMUNICATION
// =============================================================================

model Notification {
  id         String               @id @default(uuid())
  customerId String?
  staffId    String?
  deviceId   String?
  channel    NotificationChannel
  category   NotificationCategory
  type       String // e.g. "ORDER_PLACED", "NEW_ORDER"
  title      String
  body       String
  entityType String?
  entityId   String?
  status     NotificationStatus   @default(PENDING)
  sentAt     DateTime?
  deliveredAt DateTime?
  readAt     DateTime?
  createdAt  DateTime             @default(now())

  customer Customer? @relation(fields: [customerId], references: [id])

  @@index([customerId, status])
  @@index([staffId, status])
  @@index([createdAt])
  @@map("notifications")
}

model NotificationTemplate {
  id            String              @id @default(uuid())
  key           String              @unique
  channel       NotificationChannel
  titleTemplate String
  bodyTemplate  String
  isActive      Boolean             @default(true)

  @@map("notification_templates")
}

// =============================================================================
// REVIEWS
// =============================================================================

model Review {
  id         String   @id @default(uuid())
  customerId String
  productId  String
  orderId    String
  rating     Int // 1-5
  comment    String?
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())

  customer Customer      @relation(fields: [customerId], references: [id])
  product  Product       @relation(fields: [productId], references: [id])
  order    Order         @relation(fields: [orderId], references: [id])
  reply    ReviewReply?

  @@unique([customerId, productId, orderId])
  @@index([productId, isApproved])
  @@map("reviews")
}

model ReviewReply {
  id        String   @id @default(uuid())
  reviewId  String   @unique
  staffId   String
  reply     String
  createdAt DateTime @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  staff  Staff  @relation(fields: [staffId], references: [id])

  @@map("review_replies")
}

// =============================================================================
// SECURITY
// =============================================================================

model AuditLog {
  id           String    @id @default(uuid())
  actorId      String?
  actorType    ActorType
  action       String // e.g. "PRODUCT_PRICE_UPDATED"
  entityType   String
  entityId     String
  oldValue     Json?
  newValue     Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime  @default(now())

  actorStaff Staff? @relation("AuditLogActor", fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

model LoginAttempt {
  id          String    @id @default(uuid())
  identifier  String // email or mobile number
  actorType   ActorType
  success     Boolean
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime  @default(now())

  @@index([identifier, createdAt])
  @@map("login_attempts")
}

model SecurityEvent {
  id         String    @id @default(uuid())
  type       String // e.g. "MULTIPLE_FAILED_LOGINS", "TOKEN_REUSE_DETECTED"
  actorType  ActorType?
  actorId    String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime  @default(now())

  @@index([type, createdAt])
  @@map("security_events")
}

// =============================================================================
// TRANSACTIONAL OUTBOX (section 37)
// =============================================================================

model OutboxEvent {
  id            String       @id @default(uuid())
  aggregateType String // "Order", "Payment", ...
  aggregateId   String
  eventType     String // DomainEvent value, e.g. "OrderCreated"
  payload       Json
  status        OutboxStatus @default(PENDING)
  retryCount    Int          @default(0)
  publishedAt   DateTime?
  createdAt     DateTime     @default(now())

  @@index([status, createdAt])
  @@map("outbox_events")
}
